<Window x:Class="MonitoringSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MonitoringSystem.ViewModel"
        xmlns:base="clr-namespace:MonitoringSystem.Base"
        xmlns:local="clr-namespace:MonitoringSystem" xmlns:viewmodel="clr-namespace:MonitoringSystem.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:MainViewModel}"
        mc:Ignorable="d"
        FontFamily="Microsoft YaHei" FontWeight="ExtraLight"
        Title="科技节能管理系统" Height="750" Width="1300"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
        MouseMove="Window_MouseMove"
        x:Name="window"
        PreviewMouseDown="Window_PreviewMouseDown">
        
    <Window.Resources>
        
        <ResourceDictionary>
            <vm:LoginViewModel x:Key="LoginViewModel"/>

            <!-- 用户下拉菜单按钮样式 -->
            <Style x:Key="PopupMenuButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#EEEEEE"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#3D3D3D"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#4A4A4A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <ResourceDictionary.MergedDictionaries>
                
                <ResourceDictionary Source="/Assets/Styles/WindowControlButtonStyle.xaml"/>
                <ResourceDictionary>
                <Style TargetType="RadioButton" x:Key="NavTabButtonStyle">
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="Foreground" Value="#DDD"/>
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="Margin" Value="5,0"/>
                    <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Command" Value="{Binding TabChangedCommand}"/>
                        <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Border Background="{TemplateBinding Background}" CornerRadius="5,5,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Height="17" />
                                        <ContentPresenter Grid.Column="1"  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"/>
                                    </Grid>

                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="#FF6800"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                    
                    
                    <!--菜单栏-->
                    <Style TargetType="MenuItem" x:Key="MenuItemStyle">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="MenuItem">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            Width="{TemplateBinding Width}"
                                            Height="{TemplateBinding Height}"
                                            BorderThickness="0">
                                        <Grid>
                                        <ContentPresenter ContentSource="Header"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"
                                                          TextBlock.Foreground="{TemplateBinding Foreground}"
                                                          TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                                          TextBlock.FontSize="{TemplateBinding FontSize}"/>
                                            <ContentPresenter ContentSource="Icon"
                                                              HorizontalAlignment="Left"
                                                              VerticalAlignment="Center"
                                                              Height="16"
                                                              Width="16"
                                                              Margin="30,0,0,0"/>
                                             <Popup x:Name="popup"
                                                    AllowsTransparency="True"
                                                    IsOpen="{Binding IsSubmenuOpen,RelativeSource={RelativeSource TemplatedParent}}"
                                                    Placement="Left" >

                                                <Border  Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding Background}">
                                                    <ItemsPresenter x:Name="ItemsPresenter"/>
                                                </Border>


                                            </Popup>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter> 
                    </Style>
                    
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.7" GradientOrigin="0.5,0.7" RadiusX="0.8" RadiusY="0.8">
                <GradientStop Color="#FFA4B3D3"/>
                <GradientStop Color="#FF302C5D" Offset="0.952"/>
                <GradientStop Color="#FF697080" Offset="0"/>
                <GradientStop Color="#FE8795B3" Offset="0"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid MouseLeftButtonDown="Grid_MouseLeftButtonDown" Background="Transparent" Grid.Row="0">
            <Border BorderBrush="#FF6800" BorderThickness="0,0,0,1" Margin="20,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/Image/系统.png" Height="80" Margin="2,0,0,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="科技节能管理系统" Foreground="White" FontSize="25" Margin="10,0,0,0"/>
                        <Border Height="45" Background="Transparent">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <!--RadioButton提供一组互斥的选项，让用户只能从中选择一个，且选中后除非点击其他选项，否则不会自动取消 -->
                                <RadioButton  Content="系统监控" CommandParameter="MonitoringSystem.View.SystemMonitor" Tag="D:\c#\MonitoringSystem\MonitoringSystem\Assets\Image\系统监控.png" Style="{StaticResource NavTabButtonStyle}" IsChecked="True"/>
                                <RadioButton Content="实时曲线" CommandParameter="MonitoringSystem.View.RealTimeCurve" Tag="D:\c#\MonitoringSystem\MonitoringSystem\Assets\Image\实时曲线.png" Style="{StaticResource NavTabButtonStyle}"/>
                                <RadioButton Content="系统操作" CommandParameter="MonitoringSystem.View.SystemOperation" Tag="D:\c#\MonitoringSystem\MonitoringSystem\Assets\Image\系统操作.png" Style="{StaticResource NavTabButtonStyle}"/>
                                <RadioButton Content="报警管理" CommandParameter="MonitoringSystem.View.AlarmManegerSystem"  Tag="D:\c#\MonitoringSystem\MonitoringSystem\Assets\Image\报警管理.png" Style="{StaticResource NavTabButtonStyle}"/>
                                <RadioButton Content="报表管理" CommandParameter="MonitoringSystem.View.ReportManagement" Tag="D:\c#\MonitoringSystem\MonitoringSystem\Assets\Image\报表管理.png" Style="{StaticResource NavTabButtonStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">
                <Button  x:Name="MinimizeBtn" Click="Min_Click"  Margin="0,0,0,0" Style="{StaticResource WindowControlButtonStyle}">
                    <Path Data="M0,15 L15,15" Stroke="White" StrokeThickness="2" Width="15" Height="15" Stretch="Uniform"/>
                </Button>
                <Button x:Name="MaximizeBtn" Click="Max_Click" Style="{StaticResource WindowControlButtonStyle}">
                    <Grid Width="12" Height="12">
                        <!-- 外层框（最大化状态） -->
                        <Path x:Name="MaximizePath" 
                      Data="M0,0 L10,0 L10,10 L0,10 Z" 
                      Stroke="White" StrokeThickness="1.5" 
                      Stretch="Uniform"/>
                        <!-- 内层框（还原状态，默认隐藏） -->
                        <Path x:Name="RestorePath" 
                      Data="M2,2 L8,2 L8,8 L2,8 Z" 
                      Stroke="White" StrokeThickness="1.5" 
                      Margin="3,3,0,0" 
                      Visibility="Collapsed"
                      Stretch="Uniform"/>
                    </Grid>
                </Button>

                <!-- ★ 关闭按钮（带红色悬停效果） -->
                <Button  x:Name="CloseBtn" Click="Close_Clice" Style="{StaticResource WindowControlButtonStyle}">
                    <!-- 用Path画“×” -->
                    <Path Data="M0,0 L12,12 M0,12 L12,0" Stroke="White" StrokeThickness="2" Width="12" Height="12" Stretch="Uniform"/>
                </Button>
            </StackPanel>

            <!--<Menu Background="Transparent" VerticalAlignment="Bottom" Width="100" Height="30" HorizontalAlignment="Right" Margin="20,15">
                <MenuItem Style="{StaticResource MenuItemStyle}">
                    <MenuItem.Header>
                        <TextBlock Text="{Binding CurrentUsername}" Foreground="White" VerticalAlignment="Center" Margin="10,0"/>
                    </MenuItem.Header>
                    <MenuItem.Icon>
                        <Border Width="30" Height="30" CornerRadius="15" BorderThickness="1" BorderBrush="White">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="5" ShadowDepth="0" Direction="0" Opacity="0" Color="White"/>
                            </Border.Effect>
                            <Border.Background>
                                <ImageBrush ImageSource="/Assets/Image/用户.png"/>
                            </Border.Background>
                        </Border>
                    </MenuItem.Icon>
                </MenuItem>
            </Menu>-->

            <StackPanel Panel.ZIndex="3" 
                Orientation="Horizontal" 
                VerticalAlignment="Bottom" 
                HorizontalAlignment="Right" 
                Margin="0,0,45,0"
                        x:Name="UserInfoPanel"
                MouseLeftButtonDown="StackPanel_MouseLeftButtonDown"
                Cursor="Hand">
                <TextBlock Text="{Binding CurrentUsername}" Foreground="White" VerticalAlignment="Center" Margin="10,0"/>
                <Border Width="30" Height="30" CornerRadius="15" BorderThickness="1" BorderBrush="White">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="0" Direction="0" Opacity="0" Color="White"/>
                    </Border.Effect>
                    <Border.Background>
                        <ImageBrush ImageSource="/Assets/Image/用户.png"/>
                    </Border.Background>
                </Border>                                                       

                <!-- 弹出下拉菜单（Popup） -->
                <Popup x:Name="UserMenuPopup" 
                        PlacementTarget="{Binding ElementName=UserInfoPanel}" 
                        Placement="Bottom"
                         StaysOpen="True"
                         AllowsTransparency="True"
                         PopupAnimation="Slide">
                 <Border Background="#2A2A2A" 
                        BorderBrush="#444" 
                        BorderThickness="1" 
                        CornerRadius="4"
                        Padding="5">
                        <StackPanel Width="130">
                            <Button Content="个人中心"
                                    Style="{StaticResource PopupMenuButtonStyle}"
                                    Command="{Binding ProfileCommand}"
                                    Click="UserMenuButton_Click"/>
                            <Button Content="设置"
                                    Style="{StaticResource PopupMenuButtonStyle}"
                                    Command="{Binding SettingsCommand}"
                                    Click="UserMenuButton_Click"/>
                            <Separator Background="#444" Margin="0,5"/>
                            <Button Content="退出登录"
                                    Style="{StaticResource PopupMenuButtonStyle}"
                                    Command="{Binding LogoutCommand}"
                                    CommandParameter="{Binding ElementName=window}"
                                    Click="UserMenuButton_Click"/>
                        </StackPanel>
                    </Border>
                </Popup>
                <!--<Border Width="30" Height="30" CornerRadius="15" BorderThickness="1" BorderBrush="White">
                <Image Source="/Assets/Image/报表管理.png"/>
                </Border>-->
            </StackPanel>
        </Grid>
        <ContentControl x:Name="MyContent" Grid.Row="1" Content="{Binding MainContent}" Margin="-2,0,2,0"/>
    </Grid>
</Window>
