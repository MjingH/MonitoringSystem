<UserControl x:Class="MonitoringSystem.View.AlarmManegerSystem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MonitoringSystem.View"
             xmlns:base="clr-namespace:MonitoringSystem.Base"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1200"
             Unloaded="UserControl_Unloaded">
    <UserControl.Resources>

        <!-- 添加以下行，覆盖非活动选中背景 -->
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" 
            Color="#696e8a" />

        <!-- ============ 通用颜色与控件样式 ============ -->
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#2A2D3A"/>
            <Setter Property="Foreground" Value="#E6E9F0"/>
            <Setter Property="BorderBrush" Value="#3A3F52"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 深色下拉框 -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#2A2D3A"/>
            <Setter Property="Foreground" Value="#E6E9F0"/>
            <Setter Property="BorderBrush" Value="#3A3F52"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="#2A2D3A"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Path x:Name="arrow" Data="M0,0 L4,4 L8,0" Stroke="#9AA3B8"
                                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,10,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#5A6078"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,0,26,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"/>

                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border Background="#2A2D3A" BorderBrush="#3A3F52" BorderThickness="1"
                                        CornerRadius="4"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E6E9F0"/>
            <Setter Property="Background" Value="#2A2D3A"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A4A66"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4A5568"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 通用按钮模板 -->
        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Foreground" Value="#E6E9F0"/>
            <Setter Property="Background" Value="#3A3F52"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4A5068"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2E3348"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 强调色按钮 -->
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource FilterButtonStyle}">
            <Setter Property="Background" Value="#FF6800"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF8C3A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D95700"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险操作按钮（清除报警） -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource FilterButtonStyle}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F87171"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 统计卡片 -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#B31E2230"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- ============ 表格样式 ============ -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2E3348"/>
            <Setter Property="RowBackground" Value="#232838"/>
            <Setter Property="AlternatingRowBackground" Value="#1B1F2C"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2A2D3A"/>
            <Setter Property="Foreground" Value="#AEB4C8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#2E3348"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2E3348"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A4A66"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ 标题栏 ============ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,4,0,0">
            <Rectangle Width="4" Height="20" Fill="#FF6800" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
            <TextBlock Text="报警管理" Foreground="White" FontSize="20" FontWeight="Bold" Margin="10,0,0,0"/>
            <TextBlock Text="设备报警状态 · 报警日志 · 实时监控" Foreground="#7A8099" FontSize="12"
                       VerticalAlignment="Bottom" Margin="14,0,0,3"/>
        </StackPanel>

        <!-- ============ 统计卡片 ============ -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,12,0,0">
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="{Binding ActiveAlarmCount}" FontSize="30" FontWeight="Bold" Foreground="#F87171"/>
                    <TextBlock Text="活动报警设备" Foreground="#9AA3B8" FontSize="13" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="{Binding TotalAlarmCount}" FontSize="30" FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock Text="报警记录总数" Foreground="#9AA3B8" FontSize="13" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="{Binding WarnCount}" FontSize="30" FontWeight="Bold" Foreground="#FBBF24"/>
                    <TextBlock Text="警告" Foreground="#9AA3B8" FontSize="13" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding FaultCount}" FontSize="30" FontWeight="Bold" Foreground="#F87171"/>
                    <TextBlock Text="故障" Foreground="#9AA3B8" FontSize="13" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ============ 查询条件栏 ============ -->
        <Border Grid.Row="2" Background="#B31E2230" CornerRadius="8" Padding="16,12" Margin="0,12,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                    <Button Content="查询" Style="{StaticResource AccentButtonStyle}" Command="{Binding QueryCommand}"/>
                    <Button Content="重置" Style="{StaticResource FilterButtonStyle}" Command="{Binding ResetCommand}"/>
                    <Button Content="刷新" Style="{StaticResource AccentButtonStyle}" Command="{Binding RefreshCommand}"/>
                    <Button Content="日志详情" Style="{StaticResource FilterButtonStyle}" Command="{Binding ShowDetailCommand}"/>
                </StackPanel>

                <WrapPanel VerticalAlignment="Bottom">
                    <StackPanel Orientation="Vertical" Margin="0,0,16,0" Width="160">
                        <TextBlock Text="设备" Style="{StaticResource FilterLabel}"/>
                        <ComboBox ItemsSource="{Binding DeviceNameOptions}" SelectedItem="{Binding SelectedDeviceName}"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Margin="0,0,16,0" Width="120">
                        <TextBlock Text="日志类型" Style="{StaticResource FilterLabel}"/>
                        <ComboBox ItemsSource="{Binding LogTypeOptions}" SelectedItem="{Binding SelectedLogType}"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Width="240">
                        <TextBlock Text="关键字" Style="{StaticResource FilterLabel}"/>
                        <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding QueryCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ============ 主体：设备列表 + 报警日志 ============ -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：设备报警状态 -->
            <Border Grid.Column="0" Background="#B31E2230" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="设备报警状态" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="4,0,0,8"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding DeviceList}"
                              SelectedItem="{Binding SelectedDevice, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="设备名称" Binding="{Binding DeviceName}" Width="*"/>
                            <DataGridTemplateColumn Header="运行" Width="66">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="runBadge" CornerRadius="10" Background="#4A5568"
                                                Padding="10,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock x:Name="runText" Text="停机" Foreground="White" FontSize="12"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsRuning}" Value="True">
                                                <Setter TargetName="runText" Property="Text" Value="运行"/>
                                                <Setter TargetName="runBadge" Property="Background" Value="#16A34A"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="报警" Width="66">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="alarmBadge" CornerRadius="10" Background="#16A34A"
                                                Padding="10,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock x:Name="alarmText" Text="正常" Foreground="White" FontSize="12"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                <Setter TargetName="alarmText" Property="Text" Value="报警"/>
                                                <Setter TargetName="alarmBadge" Property="Background" Value="#DC2626"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="报警数" Binding="{Binding WarningMessageList.Count}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="当前设备报警信息" Foreground="#9AA3B8" FontSize="12" Margin="4,0,0,6"/>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedDevice.WarningMessageList}" MaxHeight="140">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#33FF4400" CornerRadius="4" Margin="0,0,0,4" Padding="8,6">
                                        <TextBlock Text="{Binding Message}" Foreground="#FFD2C8" TextWrapping="Wrap"
                                                   FontSize="12" LineHeight="18"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Grid.Row="2" Content="清除报警" Style="{StaticResource DangerButtonStyle}"
                                HorizontalAlignment="Right" Margin="0,8,0,0"
                                Command="{Binding ClearAlarmCommand}"
                                CommandParameter="{Binding SelectedDevice}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 右侧：报警日志 -->
            <Border Grid.Column="1" Background="#B31E2230" CornerRadius="8" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="报警日志" Foreground="White" FontSize="14"
                               FontWeight="SemiBold" Margin="4,0,0,8"/>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="#7A8099"
                               FontSize="12" Margin="4,8,4,0"/>
                    <DataGrid ItemsSource="{Binding AlarmLogList}" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding AlarmTime}" Width="160"/>
                            <DataGridTextColumn Header="设备名称" Binding="{Binding DeviceName}" Width="150"/>
                            <DataGridTemplateColumn Header="类型" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="badge" CornerRadius="10" Background="#D97706"
                                                Padding="10,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock x:Name="typeText" Text="警告" Foreground="White" FontSize="12"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding LogType}" Value="2">
                                                <Setter TargetName="badge" Property="Background" Value="#DC2626"/>
                                                <Setter TargetName="typeText" Property="Text" Value="故障"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="报警信息" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
