<Window x:Class="MonitoringSystem.View.LogDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MonitoringSystem.ViewModel"
        Title="日志详情" Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E">
    <Window.Resources>
        <!--<vm:LogDetailViewModel x:Key="LogDetailViewModel"/>-->
        <vm:LogDetailViewModel x:Key="LogDetailViewModel"/>
    </Window.Resources>
    <Grid DataContext="{Binding Source={StaticResource LogDetailViewModel}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#2D2D44" Padding="15,10">
            <TextBlock Text="系统运行日志" Foreground="White" FontSize="16" FontWeight="Bold"/>
        </Border>

        <!-- 日志列表 -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding LogList}" 
                  AutoGenerateColumns="False"
                  Background="White"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  BorderThickness="0"
                  GridLinesVisibility="None">
            <DataGrid.Columns >
                <DataGridTextColumn Header="序号" Binding="{Binding RowNumber}" Width="60"/>
                <DataGridTextColumn Header="设备名称" Binding="{Binding DeviceName}" Width="150"/>
                <DataGridTextColumn Header="状态" Binding="{Binding LogInfo}" Width="80"/>
                <DataGridTextColumn Header="日志信息" Binding="{Binding Message}"  Width="*"/>
                <DataGridTextColumn Header="日志类型" Binding="{Binding LogType}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="2" Background="#2D2D44"/>
    </Grid>
</Window>