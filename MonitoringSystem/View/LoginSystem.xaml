<Window x:Class="MonitoringSystem.View.LoginSystem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MonitoringSystem.View"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:MonitoringSystem.ViewModel"
        xmlns:base="clr-namespace:MonitoringSystem.Base"
        mc:Ignorable="d"
        Name="window"
        Title="LoginSystem" Height="580" Width="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" Background="{x:Null}" AllowsTransparency="True">
    <Window.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Styles/WindowControlButtonStyle.xaml"/>
                <ResourceDictionary>
                    <Style x:Key="UserTextBoxStyle" TargetType="{x:Type TextBox}">
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                        <Setter Property="Padding" Value="2,1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type TextBox}">
                                    <Border x:Name="border"
                                            CornerRadius="5"
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            Background="{TemplateBinding Background}" 
                                            SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="Gray" Grid.Column="0" Text="&#xe616;" 
                                                       FontFamily="../Assets/Image/#iconfont" FontSize="20" 
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       Opacity="0.5"/>
                                            <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost" 
                                          Focusable="false" 
                                          HorizontalScrollBarVisibility="Hidden" 
                                          VerticalScrollBarVisibility="Hidden"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="false">
                                            <Setter TargetName="border" Property="Background" 
                                Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                            <Setter Property="Foreground" 
                                Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            
            
            <SolidColorBrush x:Key="TextBox.Static.Border" Color="#FFABAdB3"/>
            <SolidColorBrush x:Key="TextBox.MouseOver.Border" Color="#FF7EB4EA"/>
            <SolidColorBrush x:Key="TextBox.Focus.Border" Color="#FF569DE5"/>
            <SolidColorBrush x:Key="TextBox.Static.Border1" Color="#FFABAdB3"/>
            <SolidColorBrush x:Key="TextBox.MouseOver.Border1" Color="#FF7EB4EA"/>
            <SolidColorBrush x:Key="TextBox.Focus.Border1" Color="#FF569DE5"/>
            
            
            <Style x:Key="PasswordBoxStyle" TargetType="{x:Type PasswordBox}">
                <Setter Property="PasswordChar" Value="●"/>
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                <Setter Property="BorderBrush" Value="{StaticResource TextBox.Static.Border1}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type PasswordBox}">
                              <Border x:Name="border"
                                    CornerRadius="5"
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    Background="{TemplateBinding Background}" 
                                    SnapsToDevicePixels="True">     
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="Gray" Grid.Column="0" Text="&#xe632;" 
                                           FontFamily="../Assets/Image/#iconfont" FontSize="20" 
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Opacity="0.5"/>
                                    <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost" 
                                          Focusable="false" 
                                          HorizontalScrollBarVisibility="Hidden" 
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>      
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource TextBox.MouseOver.Border1}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource TextBox.Focus.Border1}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>
            <SolidColorBrush x:Key="TextBox.Static.Border2" Color="#FFABAdB3"/>
            <SolidColorBrush x:Key="TextBox.MouseOver.Border2" Color="#FF7EB4EA"/>
            <SolidColorBrush x:Key="TextBox.Focus.Border2" Color="#FF569DE5"/>
            
            <!--验证码-->
            <Style x:Key="CodeTextBoxStyle" TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                <Setter Property="BorderBrush" Value="{StaticResource TextBox.Static.Border2}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="border"
                                CornerRadius="5"
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Background="{TemplateBinding Background}" 
                                SnapsToDevicePixels="True"> 
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="Gray" Grid.Column="0" Text="&#xe624;" 
                                           FontFamily="../Assets/Image/#iconfont" FontSize="20" 
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Opacity="0.5"/>  
                                    <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost" 
                                          Focusable="false" 
                                          HorizontalScrollBarVisibility="Hidden" 
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Background="Transparent" 
                                            Command="{Binding RefreshCaptchaCommand}" BorderThickness="0"
                                            Cursor="Hand"
                                            Padding="0"
                                            Height="30" Width="90">
                                        <Image  Height="30" Width="90" Source="{Binding CaptchaImageSource}"/>
                                    </Button>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource TextBox.MouseOver.Border2}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource TextBox.Focus.Border2}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>
            
            <!--菜单栏-->
            <Style x:Key="MenuItemStyle" TargetType="MenuItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type MenuItem}">
                            <Border Name="border"
                                    Background="{TemplateBinding Background}"
                                    Width="{TemplateBinding Width}"
                                    Height="{TemplateBinding Height}"
                                    BorderThickness="0">
                                <Grid>
                                    <ContentPresenter ContentSource="Icon"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" 
                                                      Width="40" Height="30"/>
                                    <Popup x:Name="popup"
                                           AllowsTransparency="True"
                                           IsOpen="{Binding IsSubmenuOpen,RelativeSource={RelativeSource TemplatedParent}}"
                                           Placement="Left"
                                           >
                                        <Border  Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding Background}">
                                            <ItemsPresenter x:Name="ItemsPresenter"/>
                                        </Border>
                                        
                                        
                                    </Popup>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#22FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#3A3A3A"/>
                                    </Trigger>
                               
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
        
    </Window.Resources>
    <Border Margin="5" Background="White" CornerRadius="10" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="Gray" Direction="0" ShadowDepth="0" BlurRadius="10" Opacity="0.3"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2.8*"/>
                <RowDefinition Height="3.6*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            <Border Background="#007DFA" CornerRadius="10,10,0,0" Margin="2" >
                <!--左上角-->
                <Grid>
                    
                    <Border VerticalAlignment="Top" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                           
                            <!--<Button  x:Name="HamburgerButton"  Style="{StaticResource WindowControlButtonStyle}">
                                <Path Data="M736 352H288a32 32 0 1 1 0-64h448a32 32 0 0 1 0 64z m0 192H288a32 32 0 1 1 0-64h448a32 32 0 0 1 0 64z m0 192H288a32 32 0 0 1 0-64h448a32 32 0 0 1 0 64z"  
                                  Width="12" Height="12" Stretch="Uniform" Stroke="White" StrokeThickness="1.2"/>
                            </Button>-->
                            <Menu Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,5,0">
                             
                                <MenuItem  Style="{StaticResource MenuItemStyle}">
                                    <MenuItem.Icon>
                                        <Path Data="M736 352H288a32 32 0 1 1 0-64h448a32 32 0 0 1 0 64z m0 192H288a32 32 0 1 1 0-64h448a32 32 0 0 1 0 64z m0 192H288a32 32 0 0 1 0-64h448a32 32 0 0 1 0 64z"  
                                                Width="12" Height="12" Stretch="Uniform" Stroke="White" StrokeThickness="1.2"/>
                                    </MenuItem.Icon>
                                    <MenuItem Header="忘记密码"  Background="White"/>
                                    <MenuItem Header="问题反馈" Background="White"  />
                                </MenuItem>
                            </Menu>

                            <!-- ★ 关闭按钮（带红色悬停效果） -->
                            <Button Command="{Binding CloseWindowCommand}" 
                                    CommandParameter="{Binding ElementName=window}" 
                                    x:Name="CloseBtn" 
                                     Style="{StaticResource WindowControlButtonStyle}">

                                <!-- 用Path画“×” -->
                                <Path Data="M0,0 L12,12 M0,12 L12,0" Stroke="White" StrokeThickness="2" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <!--中上-->
            <Border Grid.Row="0">
            </Border>
            <Border VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <Image  Source="/Assets/Image/系统-4.png" Height="60" Margin="10"/>

                    <TextBlock Text="温度湿度监控系统" Foreground="White" FontSize="25"/>
                </StackPanel>
            </Border>

            <!--中下-->
            <Grid Grid.Row="1" FocusManager.FocusedElement="{Binding ElementName=txtUserName}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar  VerticalAlignment="Top" Height="2"  IsIndeterminate="True" Foreground="Orange" Visibility="{Binding IsLoading,Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBox  x:Name="txtUserName" Height="40" Text="{Binding UserModel.UserName,UpdateSourceTrigger=PropertyChanged}" Foreground="#555" FontSize="16"
                          Margin="30,20,30,10" Style="{StaticResource UserTextBoxStyle}" BorderThickness="1">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" 
                                    Command="{Binding LoginCommand}"  
                                    CommandParameter="{Binding ElementName=window}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <PasswordBox  base:PasswordhHelper.Attached="True" base:PasswordhHelper.Password="{Binding UserModel.Password,
                    Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Foreground="#555"   Style="{DynamicResource PasswordBoxStyle}"  
                              Grid.Row="1" FontSize="16"  Height="40" Margin="30,20,30,10">
                    <PasswordBox.InputBindings>
                        <KeyBinding Key="Enter" 
                     Command="{Binding LoginCommand}"  
                     CommandParameter="{Binding ElementName=window}"/>
                    </PasswordBox.InputBindings>
                </PasswordBox>
                <!--<TextBox Style="{DynamicResource CodeTextBoxStyle}"  Grid.Row="2" Height="45" Margin="20"/>-->
                <TextBox Text="{Binding UserInput,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="40"  Foreground="#555" Grid.Row="2" FontSize="16"
          Margin="30,20,30,10" Style="{DynamicResource CodeTextBoxStyle}" BorderThickness="1">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" 
                Command="{Binding LoginCommand}"  
                CommandParameter="{Binding ElementName=window}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <!--<Button Content="登录" Grid.Row="3"  Margin="20" Background="#007DFA" Style="{x:Null}">
                    
                </Button>-->
                <TextBlock Grid.Row="4" Text="{Binding MessageError}" Margin="20,0,0,0" Foreground="Red" FontSize="14" LineHeight="22" />
                <Button
                Height="45"
                Width="250"
                Grid.Row="4"
                FontSize="20"
                Command="{Binding LoginCommand}"  
                CommandParameter="{Binding ElementName=window}"
                Content="登   录"
                    IsDefault="True"
               Background="#007DFA"
               Foreground="White"
               Margin="20,25,20,0"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
              IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>

            </Grid>
            <!--<TextBlock Text="忘记密码" HorizontalAlignment="Right" Grid.Row="2" FontSize="18" Margin="0,0,40,0"/>-->
        </Grid>
    </Border>
</Window>
