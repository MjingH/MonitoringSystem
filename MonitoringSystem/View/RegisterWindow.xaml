<Window x:Class="MonitoringSystem.View.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MonitoringSystem.View"
        xmlns:base="clr-namespace:MonitoringSystem.Base"
        mc:Ignorable="d"
        Name="window"
        Title="注册账号" Height="540" Width="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" Background="{x:Null}" AllowsTransparency="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- 输入框样式 -->
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Background" Value="#F5F7FA"/>
            <Setter Property="BorderBrush" Value="#D9E1EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#007DFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 密码框样式 -->
        <Style x:Key="InputPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Background" Value="#F5F7FA"/>
            <Setter Property="BorderBrush" Value="#D9E1EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="PasswordChar" Value="●"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#007DFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮样式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#007DFA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="5" Background="White" CornerRadius="10" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#6f6f6f" Direction="0" ShadowDepth="0" BlurRadius="10" Opacity="0.3"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部标题栏 -->
            <Border  CornerRadius="10,10,0,0" Margin="2" Background="#FFDBDFDD">
                <Grid>
                    
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Command="{Binding CloseCommand}" CommandParameter="{Binding ElementName=window}">
                        <Path Data="M0,0 L12,12 M0,12 L12,0" Stroke="#FF424242"  StrokeThickness="2"
                              Width="15" Height="15" Stretch="Uniform" Margin="5"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 表单 -->
            <StackPanel Grid.Row="1" Margin="110,20">
                <TextBlock Text="欢迎注册"  FontSize="20" FontWeight="Bold"
           VerticalAlignment="Bottom" Margin="-5,0,0,0"/>
                <!--<ProgressBar Height="2" IsIndeterminate="True" Foreground="Orange"
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>-->

                <TextBlock Text="用户名" Foreground="#555" FontSize="13" Margin="0,12,0,6"/>
                <TextBox Style="{StaticResource InputTextBoxStyle}"
                         Text="{Binding UserModel.UserName, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding RegisterCommand}" CommandParameter="{Binding ElementName=window}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <TextBlock Text="密码" Foreground="#555" FontSize="13" Margin="0,14,0,6"/>
                <PasswordBox Style="{StaticResource InputPasswordBoxStyle}"
                             base:PasswordhHelper.Attached="True"
                             base:PasswordhHelper.Password="{Binding UserModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <PasswordBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding RegisterCommand}" CommandParameter="{Binding ElementName=window}"/>
                    </PasswordBox.InputBindings>
                </PasswordBox>
                
                <TextBlock Text="确认密码" Foreground="#555" FontSize="13" Margin="0,14,0,6"/>
                <PasswordBox Style="{StaticResource InputPasswordBoxStyle}"
                             base:PasswordhHelper.Attached="True"
                             base:PasswordhHelper.Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <PasswordBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding RegisterCommand}" CommandParameter="{Binding ElementName=window}"/>
                    </PasswordBox.InputBindings>
                </PasswordBox>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <TextBlock Text="性别" Foreground="#555" FontSize="14" VerticalAlignment="Center"/>
                    <RadioButton Content="男" GroupName="sex" IsChecked="{Binding IsMale}"
                                 Foreground="#555" FontSize="14" Margin="20,0,0,0" VerticalAlignment="Center"/>
                    <RadioButton Content="女" GroupName="sex" IsChecked="{Binding IsFemale}"
                                 Foreground="#555" FontSize="14" Margin="20,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="{Binding MessageError}" Foreground="Red" FontSize="13"
                           TextWrapping="Wrap" Margin="0,12,0,0"/>

                <Button Content="注  册" Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,16,0,0"
                        IsDefault="True"
                        Command="{Binding RegisterCommand}"
                        CommandParameter="{Binding ElementName=window}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
