                    <!--冷却塔-->
                    <myCtl:CoolingTower Width="90" Height="110" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="125,0,0,95"
                                        Command="{Binding Path=(vm:SystemMonitorViewModel.conponentCommand)}"
                                        CommandParameter="{Binding Path=(base:GlobalMonitor.DeviceList)[2]}"
                                        IsRunning="{Binding Path=(base:GlobalMonitor.DeviceList)[2].IsRuning}"
                                        IsFault="{Binding Path=(base:GlobalMonitor.DeviceList)[2].IsWarning}"/>
                    <myCtl:CoolingTower Width="95" Height="115" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="98,0,0,52"
                                         Command="{Binding Path=(vm:SystemMonitorViewModel.conponentCommand)}"
                                         CommandParameter="{Binding Path=(base:GlobalMonitor.DeviceList)[1]}"
                                        IsRunning="{Binding Path=(base:GlobalMonitor.DeviceList)[1].IsRuning}"
                                        IsFault="{Binding Path=(base:GlobalMonitor.DeviceList)[1].IsWarning}"/>
                    <myCtl:CoolingTower Width="100" Height="120" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="70,0,0,10"
