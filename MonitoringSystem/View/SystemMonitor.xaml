<UserControl x:Class="MonitoringSystem.View.SystemMonitor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MonitoringSystem.View"
             xmlns:myCtl="clr-namespace:WpfControlLibrary1;assembly=WpfControlLibrary1"
             xmlns:vm="clr-namespace:MonitoringSystem.ViewModel"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:base="clr-namespace:MonitoringSystem.Base"
             xmlns:converter="clr-namespace:MonitoringSystem.Base.Converter"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1200">
    <UserControl.Resources>
        <!--<vm:SystemMonitorViewModel x:Key="smVM"/>-->
        <vm:SystemMonitorViewModel x:Key="smVM"/>
        <converter:BoolToVisvilityConverter x:Key="BoolToVisvilityConverter"/>

        <ControlTemplate TargetType="Button" x:Key="ButtonTemplate">
            <Border  x:Name="border" Background="{TemplateBinding Background }">
                <TextBlock x:Name="contentText" 
                   Text="{TemplateBinding Content}" 
                   HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                   VerticalAlignment="{TemplateBinding VerticalAlignment}"
                   FontSize="{TemplateBinding FontSize}"     
                   Foreground="{TemplateBinding Foreground}" /> 
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background" Value="#22FFFFFF"/>
                    <Setter TargetName="contentText" Property="FontSize" Value="12"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate TargetType="ToggleButton" x:Key="StateButtonTemplate">
            <Border CornerRadius="3" Background="#EEE" Height="20" Name="back" Width="50">
                <Grid>
                    <TextBlock Text="停机" VerticalAlignment="Center" Margin="4,0" FontSize="9"/>
                    <TextBlock Text="运行" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="9" Margin="4,0"/>
                    <Border Margin="2" HorizontalAlignment="Left" VerticalAlignment="Center" Width="26" Background="#DDD" CornerRadius="2" Height="20">
                        <TextBlock Text="||" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="9"/>
                        <Border.RenderTransform>
                            <TranslateTransform X="22" x:Name="tt"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Duration="0:0:0:0.2" To="0" Storyboard.TargetName="tt" Storyboard.TargetProperty="X"/>
                                <ColorAnimation Duration="0:0:0:0.2" To="#38baec" Storyboard.TargetName="back" Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Duration="0:0:0.2"  Storyboard.TargetName="tt" Storyboard.TargetProperty="X"/>
                                <ColorAnimation Duration="0:0:0.2"  Storyboard.TargetName="back" Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate TargetType="ToggleButton" x:Key="WarningButtonTemplate">
            <Image Source="/Assets/Image/报警红灯.png" Width="100" Height="20" x:Name="txt"  Opacity="0" HorizontalAlignment="Right"/>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Opacity" Value="1" TargetName="txt"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>
    <Grid  DataContext="{Binding Source={StaticResource smVM}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="97*"/>
            <ColumnDefinition Width="48*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Canvas Background="Transparent" 
                MouseWheel="Canvas_MouseWheel"
                MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                MouseMove="Canvas_MouseMove">
            <Viewbox Canvas.Left="0" Canvas.Top="340"  Name="mainView">
                <Grid>

                    <!--多边形塔-->
                    <myCtl:PolygonTower Height="70" Width="70" Panel.ZIndex="1" Margin="442,101,689,83" RenderTransformOrigin="0.5,0.5">
                        <myCtl:PolygonTower.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="0.859"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </myCtl:PolygonTower.RenderTransform>
                    </myCtl:PolygonTower>

                    <myCtl:PolygonTower Height="70" Width="70" Panel.ZIndex="1" Margin="520,102,611,82" RenderTransformOrigin="0.5,0.5">
                        <myCtl:PolygonTower.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="0.859"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </myCtl:PolygonTower.RenderTransform>
                    </myCtl:PolygonTower>

                    <!--背景-->
