<UserControl x:Class="MonitoringSystem.View.SystemOperation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MonitoringSystem.View"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1200">
    <UserControl.Resources>
        <!-- ============ 通用控件样式 ============ -->
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#2A2D3A"/>
            <Setter Property="Foreground" Value="#E6E9F0"/>
            <Setter Property="BorderBrush" Value="#3A3F52"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 深色下拉框 -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#2A2D3A"/>
            <Setter Property="Foreground" Value="#E6E9F0"/>
            <Setter Property="BorderBrush" Value="#3A3F52"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="#2A2D3A"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Path x:Name="arrow" Data="M0,0 L4,4 L8,0" Stroke="#9AA3B8"
                                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,10,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#5A6078"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,0,26,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"/>

                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border Background="#2A2D3A" BorderBrush="#3A3F52" BorderThickness="1"
                                        CornerRadius="4"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E6E9F0"/>
            <Setter Property="Background" Value="#2A2D3A"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A4A66"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4A5568"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 通用按钮 -->
        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Foreground" Value="#E6E9F0"/>
            <Setter Property="Background" Value="#3A3F52"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4A5068"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2E3348"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource FilterButtonStyle}">
            <Setter Property="Background" Value="#FF6800"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF8C3A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D95700"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 统计卡片 -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#B31E2230"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- ============ 表格样式 ============ -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2E3348"/>
            <Setter Property="RowBackground" Value="#232838"/>
            <Setter Property="AlternatingRowBackground" Value="#1B1F2C"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2A2D3A"/>
            <Setter Property="Foreground" Value="#AEB4C8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#2E3348"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2E3348"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A4A66"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ 标签页样式 ============ -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#9AA3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="#2A2D3A" Padding="18,9" CornerRadius="6,6,0,0">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="SemiBold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF6800"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分区卡片 -->
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="#B31E2230"/>
            <Setter Property="CornerRadius" Value="0,8,8,8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- 添加以下行，覆盖非活动选中背景 -->
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" 
                     Color="#232838" />
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ 标题栏 ============ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,4,0,0">
            <Rectangle Width="4" Height="20" Fill="#FF6800" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
            <TextBlock Text="系统操作" Foreground="White" FontSize="20" FontWeight="Bold" Margin="10,0,0,0"/>
            <TextBlock Text="设备管理 · 用户管理 · 存储区配置 · 串口设置" Foreground="#7A8099" FontSize="12"
                       VerticalAlignment="Bottom" Margin="14,0,0,3"/>
        </StackPanel>

        <!-- ============ 统计卡片 ============ -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,12,0,0">
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="{Binding DeviceCount}" FontSize="30" FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock Text="设备总数" Foreground="#9AA3B8" FontSize="13" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="{Binding UserCount}" FontSize="30" FontWeight="Bold" Foreground="#34D399"/>
                    <TextBlock Text="用户总数" Foreground="#9AA3B8" FontSize="13" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="{Binding StorageCount}" FontSize="30" FontWeight="Bold" Foreground="#FBBF24"/>
                    <TextBlock Text="存储区数" Foreground="#9AA3B8" FontSize="13" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding CurrentUsername}" FontSize="24" FontWeight="Bold" Foreground="#C084FC"/>
                    <TextBlock Text="当前登录用户" Foreground="#9AA3B8" FontSize="13" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ============ 标签页 ============ -->
        <TabControl Grid.Row="2" Margin="0,12,0,0">

            <!-- 设备管理 -->
            <TabItem Header="设备管理">
                <Border Style="{StaticResource PanelCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,12,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="设备列表" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="4,0,0,8"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding DeviceList}" IsReadOnly="True"
                                      SelectedItem="{Binding SelectedDevice, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding DeviceId}" Width="60"/>
                                    <DataGridTextColumn Header="设备名称" Binding="{Binding DeviceName}" Width="*"/>
                                    <DataGridTemplateColumn Header="运行" Width="66">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border x:Name="runBadge" CornerRadius="10" Background="#4A5568"
                                                        Padding="10,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock x:Name="runText" Text="停机" Foreground="White" FontSize="12"/>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsRuning}" Value="True">
                                                        <Setter TargetName="runText" Property="Text" Value="运行"/>
                                                        <Setter TargetName="runBadge" Property="Background" Value="#16A34A"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="报警" Width="66">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border x:Name="alarmBadge" CornerRadius="10" Background="#16A34A"
                                                        Padding="10,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock x:Name="alarmText" Text="正常" Foreground="White" FontSize="12"/>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                        <Setter TargetName="alarmText" Property="Text" Value="报警"/>
                                                        <Setter TargetName="alarmBadge" Property="Background" Value="#DC2626"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="监控点位" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="4,0,0,8"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedDevice.MonitorValueList}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="点位名称" Binding="{Binding ValueName}" Width="*"/>
                                    <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="70"/>
                                    <DataGridTextColumn Header="当前值" Binding="{Binding CurrentValue}" Width="90"/>
                                    <DataGridTextColumn Header="数据类型" Binding="{Binding DataType}" Width="90"/>
                                    <DataGridTextColumn Header="报警下限" Binding="{Binding LowAlarm}" Width="90"/>
                                    <DataGridTextColumn Header="报警上限" Binding="{Binding HighAlarm}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- 用户管理 -->
            <TabItem Header="用户管理">
                <Border Style="{StaticResource PanelCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="系统用户" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="4,0,0,8"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding UserList}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                <DataGridTextColumn Header="用户名" Binding="{Binding UserName}" Width="*"/>
                                <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="140"/>
                                <DataGridTemplateColumn Header="性别" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="sexText" Text="女" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Sex}" Value="True">
                                                    <Setter TargetName="sexText" Property="Text" Value="男"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="状态" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="stBadge" CornerRadius="10" Background="#DC2626"
                                                    Padding="10,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock x:Name="stText" Text="禁用" Foreground="White" FontSize="12"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="True">
                                                    <Setter TargetName="stText" Property="Text" Value="启用"/>
                                                    <Setter TargetName="stBadge" Property="Background" Value="#16A34A"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime}" Width="170"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- 存储区配置 -->
            <TabItem Header="存储区配置">
                <Border Style="{StaticResource PanelCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Modbus 存储区" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="4,0,0,8"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding StorageList}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="80"/>
                                <DataGridTextColumn Header="从站地址" Binding="{Binding SlaveAddress}" Width="*"/>
                                <DataGridTextColumn Header="功能码" Binding="{Binding FuncCode}" Width="120"/>
                                <DataGridTextColumn Header="起始地址" Binding="{Binding StartAddress}" Width="120"/>
                                <DataGridTextColumn Header="长度" Binding="{Binding Length}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- 串口设置 -->
            <TabItem Header="串口设置">
                <Border Style="{StaticResource PanelCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="通讯串口参数" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="4,0,0,8"/>

                        <WrapPanel Grid.Row="1">
                            <StackPanel Orientation="Vertical" Margin="0,0,20,16" Width="220">
                                <TextBlock Text="端口号" Style="{StaticResource FilterLabel}"/>
                                <TextBox Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Orientation="Vertical" Margin="0,0,20,16" Width="180">
                                <TextBlock Text="波特率" Style="{StaticResource FilterLabel}"/>
                                <ComboBox ItemsSource="{Binding BaudRateOptions}" SelectedItem="{Binding BaudRate}"/>
                            </StackPanel>

                            <StackPanel Orientation="Vertical" Margin="0,0,20,16" Width="140">
                                <TextBlock Text="数据位" Style="{StaticResource FilterLabel}"/>
                                <ComboBox ItemsSource="{Binding DataBitOptions}" SelectedItem="{Binding DataBit}"/>
                            </StackPanel>

                            <StackPanel Orientation="Vertical" Margin="0,0,20,16" Width="160">
                                <TextBlock Text="校验位" Style="{StaticResource FilterLabel}"/>
                                <ComboBox ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding Parity}"/>
                            </StackPanel>

                            <StackPanel Orientation="Vertical" Margin="0,0,20,16" Width="160">
                                <TextBlock Text="停止位" Style="{StaticResource FilterLabel}"/>
                                <ComboBox ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding StopBits}"/>
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Content="刷新" Style="{StaticResource FilterButtonStyle}" Margin="0,0,0,0"
                                    Command="{Binding RefreshCommand}"/>
                            <Button Content="保存串口设置" Style="{StaticResource AccentButtonStyle}"
                                    Command="{Binding SaveSerialCommand}"/>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#7A8099" FontSize="12"
                                       VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
